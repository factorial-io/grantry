{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "last-release-sha": "a06c6c1a6995ad02fa1c2cca9f1cca37daea5c1e",
  "packages": {
    "grantry": {
      "release-type": "rust",
      "pull-request-title-pattern": "chore${scope}: release ${version}",
      "changelog-path": "CHANGELOG.md",
      "release-as": "0.5.0"
    },
    "grantry-redis": {
      "release-type": "rust",
      "component": "grantry-redis",
      "include-component-in-tag": true,
      "pull-request-title-pattern": "chore${scope}: release grantry-redis ${version}",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": [
    "cargo-workspace"
  ]
}
